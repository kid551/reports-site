---
import { promises as fs } from "node:fs"
import path from "node:path"
import "../styles/global.css"
import { UNTAGGED, type PostMeta } from "../lib/types"
import PostCard from "../components/PostCard.astro"

const generatedPath = path.resolve(process.cwd(), ".generated/posts.json")
let posts: PostMeta[] = []
try {
  posts = JSON.parse(await fs.readFile(generatedPath, "utf8")) as PostMeta[]
} catch {
  posts = []
}

const tagsOf = (p: PostMeta): string[] => (p.keywords.length ? p.keywords : [UNTAGGED])

// 标签按出现次数降序，「未分类」永远排最后
const tagCounts = new Map<string, number>()
for (const p of posts) {
  for (const t of tagsOf(p)) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)
}
const tags = Array.from(tagCounts.keys()).sort((a, b) => {
  if (a === UNTAGGED) return 1
  if (b === UNTAGGED) return -1
  return tagCounts.get(b)! - tagCounts.get(a)! || a.localeCompare(b, "zh")
})

// posts/ 下的子目录在列表页折叠成一组：目录名一行，子文章缩进在里面。
// 只按第一层目录分组（更深的层级一并平铺进同一组），posts.json 已是新→旧顺序，遍历时保持。
type Entry =
  | { kind: "post"; date: string; post: PostMeta }
  | {
      kind: "folder"
      date: string
      dir: string
      title: string
      href: string | null
      posts: PostMeta[]
    }

const folderTitle = (dir: string) => dir.replace(/^\d{8}(?:-\d{6})?-/, "")

const entries: Entry[] = []
const folders = new Map<string, Extract<Entry, { kind: "folder" }>>()
for (const p of posts) {
  const slash = p.id.indexOf("/")
  if (slash < 0) {
    entries.push({ kind: "post", date: p.date, post: p })
    continue
  }
  const dir = p.id.slice(0, slash)
  let f = folders.get(dir)
  if (!f) {
    // 组的日期取首个（最新的）子文章，决定它落在哪个月份分组下
    f = { kind: "folder", date: p.date, dir, title: folderTitle(dir), href: null, posts: [] }
    folders.set(dir, f)
    entries.push(f)
  }
  // 目录自带的 index.html 当作这一组的封面：标题挂到组头上，不再单独占一张卡
  if (p.id === `${dir}/index.html`) {
    f.title = p.title
    f.href = p.href
  } else {
    f.posts.push(p)
  }
}

const grouped = entries.reduce<Record<string, Entry[]>>((acc, e) => {
  const ym = e.date.slice(0, 7)
  ;(acc[ym] ||= []).push(e)
  return acc
}, {})
const ymKeys = Object.keys(grouped).sort().reverse()

const baseUrl = import.meta.env.BASE_URL
const siteTitle = "Reports"
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content="本地撰写、自动发布的报告归档站。" />
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        <h1>{siteTitle}</h1>
        <p class="lede">
          收录 <b>{posts.length}</b> 篇 · 支持标题与正文全文搜索
        </p>
      </header>

      <div class="search-box">
        <input
          id="search-input"
          type="search"
          autocomplete="off"
          placeholder="搜索标题、描述、正文……"
          class="search-input"
        />
        <p id="search-status" class="search-status" aria-live="polite"></p>
      </div>

      {
        posts.length > 0 && (
          <nav class="cat-nav" id="tag-nav">
            <button type="button" data-tag="__all" class="cat-chip active">
              全部
            </button>
            {tags.map((t) => (
              <button type="button" data-tag={t} class="cat-chip">
                {t}
              </button>
            ))}
          </nav>
        )
      }

      <section id="list-default">
        {
          posts.length === 0 ? (
            <div class="empty">
              还没有文章。把 HTML 放进 <code>posts/</code> 目录后运行 <code>pnpm dev</code>。
            </div>
          ) : (
            ymKeys.map((ym) => (
              <div class="month-group" data-month={ym}>
                <h2 class="month-label">{ym}</h2>
                <ul class="post-list">
                  {grouped[ym].map((e) =>
                    e.kind === "post" ? (
                      <PostCard post={e.post} />
                    ) : (
                      <li class="folder-item" data-folder={e.dir}>
                        <details class="folder">
                          <summary class="folder-head">
                            <span class="folder-name">{e.title}</span>
                            <span class="folder-count">{e.posts.length} 篇</span>
                            {e.href && (
                              <a class="folder-index" href={e.href}>
                                目录页 →
                              </a>
                            )}
                          </summary>
                          <ul class="post-list folder-children">
                            {e.posts.map((p) => (
                              <PostCard post={p} />
                            ))}
                          </ul>
                        </details>
                      </li>
                    ),
                  )}
                </ul>
              </div>
            ))
          )
        }
      </section>

      <section id="list-search" hidden></section>

      <footer class="site-footer">
        源代码托管于 GitHub · 把 HTML 文件放进 <code>posts/</code> 目录即可发布
      </footer>
    </div>

    <script is:inline define:vars={{ baseUrl }}>
      window.__BASE_URL = baseUrl
    </script>
    <script>
      import { initSearch } from "../lib/search-client"
      initSearch()

      // 卡片编辑（标签增删 / 删除文章）只在 dev server 上启用，写文件的接口也只存在于 dev。
      // import.meta.env.DEV 在 build 时为 false，整段会被 Vite 摇掉，不进产物。
      if (import.meta.env.DEV && /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) {
        import("../lib/card-editor").then((m) => m.initCardEditor())
      }
    </script>
  </body>
</html>
