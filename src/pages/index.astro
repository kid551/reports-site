---
import { promises as fs } from "node:fs"
import path from "node:path"
import "../styles/global.css"
import type { PostMeta } from "../lib/types"

const generatedPath = path.resolve(process.cwd(), ".generated/posts.json")
let posts: PostMeta[] = []
try {
  posts = JSON.parse(await fs.readFile(generatedPath, "utf8")) as PostMeta[]
} catch {
  posts = []
}

const categories = Array.from(new Set(posts.map((p) => p.category))).sort()

const grouped = posts.reduce<Record<string, PostMeta[]>>((acc, p) => {
  const ym = p.date.slice(0, 7)
  ;(acc[ym] ||= []).push(p)
  return acc
}, {})
const ymKeys = Object.keys(grouped).sort().reverse()

const baseUrl = import.meta.env.BASE_URL
const siteTitle = "Reports"
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content="本地撰写、自动发布的报告归档站。" />
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        <h1>{siteTitle}</h1>
        <p class="lede">
          收录 <b>{posts.length}</b> 篇 · 支持标题与正文全文搜索
        </p>
      </header>

      <div class="search-box">
        <input
          id="search-input"
          type="search"
          autocomplete="off"
          placeholder="搜索标题、描述、正文……"
          class="search-input"
        />
        <p id="search-status" class="search-status" aria-live="polite"></p>
      </div>

      {
        categories.length > 1 && (
          <nav class="cat-nav" id="category-nav">
            <button type="button" data-cat="__all" class="cat-chip active">
              全部
            </button>
            {categories.map((c) => (
              <button type="button" data-cat={c} class="cat-chip">
                {c}
              </button>
            ))}
          </nav>
        )
      }

      <section id="list-default">
        {
          posts.length === 0 ? (
            <div class="empty">
              还没有文章。把 HTML 放进 <code>posts/</code> 目录后运行 <code>pnpm dev</code>。
            </div>
          ) : (
            ymKeys.map((ym) => (
              <div class="month-group" data-month={ym}>
                <h2 class="month-label">{ym}</h2>
                <ul class="post-list">
                  {grouped[ym].map((p) => (
                    <li class="post-item" data-category={p.category}>
                      <a href={p.href} class="post-card">
                        <h3 class="post-title">{p.title}</h3>
                        {p.description && <p class="post-desc">{p.description}</p>}
                        <div class="post-meta">
                          <time>{p.date}</time>
                          <span class="cat">{p.category}</span>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          )
        }
      </section>

      <section id="list-search" hidden></section>

      <footer class="site-footer">
        源代码托管于 GitHub · 把 HTML 文件放进 <code>posts/</code> 目录即可发布
      </footer>
    </div>

    <script define:vars={{ baseUrl }}>
      window.__BASE_URL = baseUrl
    </script>
    <script>
      import { initSearch } from "../lib/search-client"
      initSearch()
    </script>
  </body>
</html>
